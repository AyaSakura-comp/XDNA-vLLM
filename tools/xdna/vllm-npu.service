# systemd --user unit: cp tools/xdna/vllm-npu.service ~/.config/systemd/user/
# (edit the paths if the checkout is not ~/src/XDNA-vLLM), then
# systemctl --user daemon-reload && systemctl --user start vllm-npu
[Unit]
Description=Gemma 4 E2B int8 on XDNA-vLLM (CPU + XDNA2 NPU), OpenAI API on 127.0.0.1:8013
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/src/XDNA-vLLM
ExecStart=/bin/bash %h/src/XDNA-vLLM/tools/xdna/serve.sh
Restart=on-failure
RestartSec=15
# Prefer this over desktop apps when earlyoom has to pick something.
OOMScoreAdjust=800
TimeoutStopSec=30

[Install]
WantedBy=default.target
